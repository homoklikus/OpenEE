; OpenEE – projekt Godot (0.5.0-dev – wersja rozwojowa)
config_version=5

[application]
config/name="OpenEE"
config/description="Otwarta reimplementacja silnika Empire Earth (0.5.0-dev – wersja rozwojowa)"
config/version="0.5.0-dev"
run/main_scene="res://launcher/launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Dziennik="*res://silnik/rdzen/dziennik.gd"
Konfiguracja="*res://silnik/rdzen/konfiguracja.gd"
Zdarzenia="*res://silnik/rdzen/zdarzenia.gd"
Zasoby="*res://silnik/zasoby/zasoby.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0

[shader_globals]
czas_animacji={
"type": "float",
"value": 0.0
}
